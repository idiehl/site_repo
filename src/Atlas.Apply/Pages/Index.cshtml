@page
@model IndexModel
@{
    ViewData["Title"] = "Atlas Apply";
}

<section class="apply-page">
    <p class="apply-kicker">Atlas Apply</p>
    <h1 class="apply-title">Manage every role from saved posting to follow-up.</h1>
    <p class="apply-lede">
        Save roles, track application progress, tailor your resume, prepare for interviews, and keep your notes in one place.
    </p>

    <div class="apply-actions">
        <a class="btn btn-primary" asp-page="/Login">Sign in or create account</a>
        <a class="btn btn-outline-primary" asp-page="/Dashboard">Open dashboard</a>
    </div>
</section>
