@page "{userId:guid?}"
@model Atlas.Apply.Pages.ProfileModel
@using System.Text.Json
@using Atlas.Apply.Features.Profile
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Profile.DisplayName) ? "Profile" : Model.Profile.DisplayName;
    var profileJson = JsonSerializer.Serialize(Model.Profile, ProfileDocument.JsonOptions);
    var displayName = string.IsNullOrWhiteSpace(Model.Profile.DisplayName) ? "Your Name" : Model.Profile.DisplayName;
    var headline = string.IsNullOrWhiteSpace(Model.Profile.Headline) ? "Add a clear headline for the roles you want." : Model.Profile.Headline;
    var summary = string.IsNullOrWhiteSpace(Model.Profile.Summary)
        ? "Use this page as the polished source of truth for your experience, skills, and application materials."
        : Model.Profile.Summary;
    var currentRoleCompany = string.Join(" at ", new[] { Model.Profile.CurrentRoleTitle, Model.Profile.CurrentCompany }.Where(x => !string.IsNullOrWhiteSpace(x)));
}

<section class="apply-page profile-page @(Model.IsVisitorView ? "profile-page--visitor" : string.Empty)">
    <div id="profile-warning" class="apply-alert d-none"></div>

    <article class="apply-panel bio-module">
        <div class="bio-module__toolbar">
            <p class="apply-kicker">Profile</p>
            @if (Model.CanEditProfile)
            {
                <div class="bio-module__toolbar-actions">
                    <button type="button" class="btn btn-outline-primary btn-sm" id="bio-edit-toggle">Edit</button>
                    <small id="profile-message" class="text-muted"></small>
                </div>
            }
        </div>

        <div class="bio-module__shell">
            <div class="bio-module__left">
                <button type="button" class="bio-module__image-button" id="profile-image-trigger" @(Model.CanEditProfile ? null : "disabled")>
                    <div class="profile-image-frame profile-image-frame--hero">
                        <img id="profile-image-preview" alt="Profile image preview" class="profile-image-preview @(Model.Profile.HasProfileImage ? string.Empty : "d-none")" src="@(Model.Profile.ProfileImageUrl ?? string.Empty)" />
                        <div id="profile-image-placeholder" class="profile-image-placeholder @(Model.Profile.HasProfileImage ? "d-none" : string.Empty)">No image</div>
                        @if (Model.CanEditProfile)
                        {
                            <div class="profile-image-overlay d-none" id="profile-image-overlay" aria-hidden="true">
                                <svg viewBox="0 0 24 24" class="profile-image-overlay__icon" focusable="false" aria-hidden="true">
                                    <path d="M12 16.5a1 1 0 0 1-1-1V8.92l-2.8 2.79a1 1 0 1 1-1.4-1.42l4.5-4.5a1 1 0 0 1 1.4 0l4.5 4.5a1 1 0 1 1-1.4 1.42L13 8.92v6.58a1 1 0 0 1-1 1Z" fill="currentColor"/>
                                    <path d="M6.5 18a1 1 0 0 1 0-2h11a1 1 0 1 1 0 2h-11Z" fill="currentColor"/>
                                </svg>
                            </div>
                        }
                    </div>
                </button>
                @if (Model.CanEditProfile)
                {
                    <input id="image-upload" type="file" accept=".png,.jpg,.jpeg,.gif,.webp" hidden />
                }

                <div class="bio-module__contacts">
                    <div class="bio-contact-item @(string.IsNullOrWhiteSpace(Model.Profile.PhoneNumber) ? "d-none" : string.Empty)" id="contact-phone">
                        <span class="bio-contact-item__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" class="bio-contact-item__icon-svg" focusable="false">
                                <path d="M7.8 4.5c.4-.4 1-.5 1.5-.3l2.3 1c.6.2.9.9.8 1.5l-.4 2c0 .4 0 .8.3 1.1l2.8 2.8c.3.3.7.4 1.1.3l2-.4c.6-.1 1.2.2 1.5.8l1 2.3c.2.5.1 1.1-.3 1.5l-1.3 1.3c-.7.7-1.7 1-2.7.8-2.6-.5-5-1.8-7.2-4S5.9 10 5.4 7.4c-.2-1 .1-2 .8-2.7L7.8 4.5Z" fill="currentColor"/>
                            </svg>
                        </span>
                        <span class="bio-contact-item__value" id="contact-phone-value">@Model.Profile.PhoneNumber</span>
                    </div>
                    <div class="bio-contact-item @(string.IsNullOrWhiteSpace(Model.Profile.Email) ? "d-none" : string.Empty)" id="contact-email">
                        <span class="bio-contact-item__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" class="bio-contact-item__icon-svg" focusable="false">
                                <path d="M4 6.5A1.5 1.5 0 0 1 5.5 5h13A1.5 1.5 0 0 1 20 6.5v11a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 17.5v-11Zm1.8.1 6.2 4.8 6.2-4.8H5.8Zm12.7 1.8-5.9 4.6a1 1 0 0 1-1.2 0L5.5 8.4v9.1h13V8.4Z" fill="currentColor"/>
                            </svg>
                        </span>
                        <a class="bio-contact-item__value" id="contact-email-value" href="mailto:@Model.Profile.Email">@Model.Profile.Email</a>
                    </div>
                    <div class="bio-contact-item @(string.IsNullOrWhiteSpace(Model.Profile.LinkedInUrl) ? "d-none" : string.Empty)" id="contact-linkedin">
                        <span class="bio-contact-item__icon" aria-hidden="true">
                            <svg viewBox="0 0 16 16" class="bio-contact-item__icon-svg bio-contact-item__icon-svg--social" focusable="false">
                                <path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146ZM4.943 13.5V6.169H2.542V13.5h2.401ZM3.743 5.167c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.343-1.248-.821 0-1.358.54-1.358 1.248 0 .694.521 1.248 1.327 1.248h.016ZM13.5 13.5V9.198c0-2.304-1.228-3.375-2.863-3.375-1.321 0-1.913.73-2.244 1.243V6.169H6.001c.03.595 0 7.331 0 7.331h2.392V9.405c0-.22.016-.44.081-.598.177-.44.58-.896 1.256-.896.886 0 1.241.676 1.241 1.668V13.5H13.5Z" fill="currentColor" />
                            </svg>
                        </span>
                        <a class="bio-contact-item__value" id="contact-linkedin-value" href="@Model.Profile.LinkedInUrl" target="_blank" rel="noopener noreferrer">@Model.Profile.LinkedInUrl</a>
                    </div>
                    <div class="bio-contact-item @(string.IsNullOrWhiteSpace(Model.Profile.XUrl) ? "d-none" : string.Empty)" id="contact-x">
                        <span class="bio-contact-item__icon" aria-hidden="true">
                            <svg viewBox="0 0 16 16" class="bio-contact-item__icon-svg bio-contact-item__icon-svg--social" focusable="false">
                                <path d="M12.6.75h2.11l-4.61 5.27 5.4 8.23h-4.4l-3.45-4.5-3.94 4.5H1.6l4.93-5.64L1.25.75h4.51l3.12 4.12L12.6.75Zm-.74 12.5h1.17L5.12 1.93H3.86l8 11.32Z" fill="currentColor" />
                            </svg>
                        </span>
                        <a class="bio-contact-item__value" id="contact-x-value" href="@Model.Profile.XUrl" target="_blank" rel="noopener noreferrer">@Model.Profile.XUrl</a>
                    </div>
                    <div class="bio-contact-item @(string.IsNullOrWhiteSpace(Model.Profile.InstagramUrl) ? "d-none" : string.Empty)" id="contact-instagram">
                        <span class="bio-contact-item__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" class="bio-contact-item__icon-svg bio-contact-item__icon-svg--social" focusable="false">
                                <path d="M7.5 2h9A5.5 5.5 0 0 1 22 7.5v9A5.5 5.5 0 0 1 16.5 22h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2Zm0 2A3.5 3.5 0 0 0 4 7.5v9A3.5 3.5 0 0 0 7.5 20h9a3.5 3.5 0 0 0 3.5-3.5v-9A3.5 3.5 0 0 0 16.5 4h-9ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm5.25-2.25a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5Z" fill="currentColor" />
                            </svg>
                        </span>
                        <a class="bio-contact-item__value" id="contact-instagram-value" href="@Model.Profile.InstagramUrl" target="_blank" rel="noopener noreferrer">@Model.Profile.InstagramUrl</a>
                    </div>
                    <div class="bio-contact-item @(string.IsNullOrWhiteSpace(Model.Profile.GithubUrl) ? "d-none" : string.Empty)" id="contact-github">
                        <span class="bio-contact-item__icon" aria-hidden="true">
                            <svg viewBox="0 0 16 16" class="bio-contact-item__icon-svg bio-contact-item__icon-svg--social" focusable="false">
                                <path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.64 7.64 0 0 1 8 4.68c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8 8 0 0 0 8 0Z" fill="currentColor" />
                            </svg>
                        </span>
                        <a class="bio-contact-item__value" id="contact-github-value" href="@Model.Profile.GithubUrl" target="_blank" rel="noopener noreferrer">@Model.Profile.GithubUrl</a>
                    </div>
                    <div class="bio-contact-item @(string.IsNullOrWhiteSpace(Model.Profile.PortfolioUrl) ? "d-none" : string.Empty)" id="contact-portfolio">
                        <span class="bio-contact-item__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" class="bio-contact-item__icon-svg" focusable="false">
                                <path d="M12 4 3 10.4v1.6h1.5V20h6v-5h3V20h6v-7.99H21v-1.6L12 4Zm5.5 14h-2.5v-5h-7v5H6.5v-6.3L12 7.7l5.5 4Z" fill="currentColor"/>
                            </svg>
                        </span>
                        <a class="bio-contact-item__value" id="contact-portfolio-value" href="@Model.Profile.PortfolioUrl" target="_blank" rel="noopener noreferrer">@Model.Profile.PortfolioUrl</a>
                    </div>
                    <div class="bio-contact-item @(string.IsNullOrWhiteSpace(Model.Profile.ImportedResumeDownloadUrl) ? "d-none" : string.Empty)" id="contact-resume">
                        <span class="bio-contact-item__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" class="bio-contact-item__icon-svg" focusable="false">
                                <path d="M7 3.5h7.5L20 9v11.5A1.5 1.5 0 0 1 18.5 22h-11A1.5 1.5 0 0 1 6 20.5v-15A2 2 0 0 1 7 3.5Zm6.5 1.8V9h3.7l-3.7-3.7Zm-5.5.2v15h10V10.5h-4A1.5 1.5 0 0 1 12.5 9v-4h-4.5Z" fill="currentColor"/>
                            </svg>
                        </span>
                        <a class="bio-contact-item__value" id="contact-resume-value" href="@Model.Profile.ImportedResumeDownloadUrl" target="_blank" rel="noopener noreferrer">@(!string.IsNullOrWhiteSpace(Model.Profile.ImportedResumeFileName) ? Model.Profile.ImportedResumeFileName : "Resume.pdf")</a>
                    </div>
                </div>
            </div>

            <div class="bio-module__right">
                <div id="bio-display">
                    <h1 class="bio-module__name" id="profile-display-name-preview">@displayName</h1>
                    <div class="bio-module__meta">
                        <span id="profile-location-preview" class="@(string.IsNullOrWhiteSpace(Model.Profile.Location) ? "d-none" : string.Empty)">@Model.Profile.Location</span>
                        <span id="profile-role-company-preview" class="@(string.IsNullOrWhiteSpace(currentRoleCompany) ? "d-none" : string.Empty)">@currentRoleCompany</span>
                    </div>
                    <p class="bio-module__headline" id="profile-headline-preview">@headline</p>
                    <p class="bio-module__summary" id="profile-summary-preview">@summary</p>
                </div>

                @if (Model.CanEditProfile)
                {
                    <div class="bio-module__editor d-none" id="bio-editor">
                        <div class="bio-module__editor-grid">
                            <div>
                                <label class="form-label" for="display-name">Name</label>
                                <input class="form-control" id="display-name" value="@Model.Profile.DisplayName" />
                            </div>
                            <div>
                                <label class="form-label" for="location">Location</label>
                                <input class="form-control" id="location" value="@Model.Profile.Location" placeholder="Austin, TX" />
                            </div>
                            <div>
                                <label class="form-label" for="current-role-title">Current Position</label>
                                <input class="form-control" id="current-role-title" value="@Model.Profile.CurrentRoleTitle" placeholder="Staff Engineer" />
                            </div>
                            <div>
                                <label class="form-label" for="current-company">Current Company</label>
                                <input class="form-control" id="current-company" value="@Model.Profile.CurrentCompany" placeholder="Atlas Universalis" />
                            </div>
                            <div class="bio-module__editor-wide">
                                <label class="form-label" for="headline">Professional Headline</label>
                                <input class="form-control" id="headline" value="@Model.Profile.Headline" placeholder="AI Trainer | Data Analyst | Python, SQL, Analytics" />
                            </div>
                            <div class="bio-module__editor-wide">
                                <label class="form-label" for="summary">Summary</label>
                                <textarea class="form-control profile-textarea" id="summary" rows="5" placeholder="Write the summary that should anchor tailored resumes and application materials.">@Model.Profile.Summary</textarea>
                            </div>
                            <div>
                                <label class="form-label" for="phone-number">Phone</label>
                                <input class="form-control" id="phone-number" value="@Model.Profile.PhoneNumber" />
                            </div>
                            <div>
                                <label class="form-label" for="email">Email</label>
                                <input class="form-control" id="email" value="@Model.Profile.Email" />
                            </div>
                            <div>
                                <label class="form-label" for="linkedin-url">LinkedIn</label>
                                <input class="form-control" id="linkedin-url" value="@Model.Profile.LinkedInUrl" placeholder="https://linkedin.com/in/..." />
                            </div>
                            <div>
                                <label class="form-label" for="x-url">X</label>
                                <input class="form-control" id="x-url" value="@Model.Profile.XUrl" placeholder="https://x.com/..." />
                            </div>
                            <div>
                                <label class="form-label" for="instagram-url">Instagram</label>
                                <input class="form-control" id="instagram-url" value="@Model.Profile.InstagramUrl" placeholder="https://instagram.com/..." />
                            </div>
                            <div>
                                <label class="form-label" for="github-url">GitHub</label>
                                <input class="form-control" id="github-url" value="@Model.Profile.GithubUrl" placeholder="https://github.com/..." />
                            </div>
                            <div class="bio-module__editor-wide">
                                <label class="form-label" for="portfolio-url">Personal Website</label>
                                <input class="form-control" id="portfolio-url" value="@Model.Profile.PortfolioUrl" placeholder="https://your-site.com" />
                            </div>
                        </div>

                        <div class="resume-preview-card bio-module__resume-tools">
                            <a id="resume-preview-link" class="resume-preview-card__thumb @(string.IsNullOrWhiteSpace(Model.Profile.ImportedResumeDownloadUrl) ? "disabled" : string.Empty)" href="@Model.Profile.ImportedResumeDownloadUrl" target="_blank" rel="noopener noreferrer">
                                <img id="resume-preview-image" class="resume-preview-card__image @(string.IsNullOrWhiteSpace(Model.Profile.ImportedResumePreviewUrl) ? "d-none" : string.Empty)" src="@Model.Profile.ImportedResumePreviewUrl" alt="Imported resume preview" />
                                <div id="resume-preview-placeholder" class="resume-preview-card__placeholder @(string.IsNullOrWhiteSpace(Model.Profile.ImportedResumePreviewUrl) ? string.Empty : "d-none")">
                                    Upload a PDF resume to generate a preview image here.
                                </div>
                            </a>
                            <div class="resume-preview-card__meta">
                                <small class="text-muted" id="resume-import-name">@(!string.IsNullOrWhiteSpace(Model.Profile.ImportedResumeFileName) ? Model.Profile.ImportedResumeFileName : "No resume imported yet")</small>
                                <p class="job-copy mb-2" id="resume-import-processor">@Model.Profile.ImportedResumeSummary</p>
                                <small class="text-muted" id="resume-import-date">
                                    @(Model.Profile.ImportedResumeUtc.HasValue ? $"Imported {Model.Profile.ImportedResumeUtc.Value.ToLocalTime():g}" : string.Empty)
                                </small>
                                <div class="profile-inline-actions">
                                    <label class="btn btn-outline-primary btn-sm mb-0" for="resume-upload">Upload Document</label>
                                    <input id="resume-upload" type="file" accept=".docx,.txt,.pdf,.json" hidden />
                                    <a id="resume-open-original" class="btn btn-outline-secondary btn-sm @(string.IsNullOrWhiteSpace(Model.Profile.ImportedResumeDownloadUrl) ? "disabled" : string.Empty)" href="@Model.Profile.ImportedResumeDownloadUrl" target="_blank" rel="noopener noreferrer">Open original</a>
                                </div>
                            </div>
                        </div>

                        <div class="profile-section-attachment" id="bio-section-doc">
                            <div class="panel-head-row">
                                <h3 class="job-subtitle mb-0">Supporting document</h3>
                                <small class="text-muted">Optional file attached to the Profile section (separate from resume import below).</small>
                            </div>
                            <div class="profile-inline-actions profile-inline-actions--wrap">
                                <small class="text-muted mb-0" id="section-doc-bio-name">No supporting document</small>
                                <div class="d-flex flex-wrap gap-2 align-items-center">
                                    <label class="btn btn-outline-primary btn-sm mb-0" for="section-doc-bio-upload">Upload Document</label>
                                    <input id="section-doc-bio-upload" type="file" accept=".docx,.txt,.pdf,.json" hidden />
                                    <a id="section-doc-bio-open" class="btn btn-outline-secondary btn-sm d-none" href="#" target="_blank" rel="noopener noreferrer">Open</a>
                                </div>
                            </div>
                        </div>

                        <div class="profile-import-panel">
                            <div class="panel-head-row">
                                <h3 class="job-subtitle mb-0">LinkedIn Import</h3>
                                <small class="text-muted">Public URL or pasted profile text</small>
                            </div>
                            <div class="profile-form-grid">
                                <div class="profile-form-grid__wide">
                                    <label class="form-label" for="linkedin-import-url">LinkedIn profile URL</label>
                                    <input class="form-control" id="linkedin-import-url" placeholder="https://www.linkedin.com/in/your-profile" value="@Model.Profile.LinkedInUrl" />
                                </div>
                                <div class="profile-form-grid__wide">
                                    <label class="form-label" for="linkedin-import-text">Pasted LinkedIn profile text</label>
                                    <textarea class="form-control profile-textarea profile-textarea--compact" id="linkedin-import-text" rows="4" placeholder="If LinkedIn blocks the URL fetch, paste the visible profile text here instead."></textarea>
                                </div>
                            </div>
                            <div class="profile-inline-actions">
                                <button type="button" class="btn btn-outline-primary btn-sm" id="import-linkedin">Import LinkedIn profile</button>
                                <small id="linkedin-import-result" class="text-muted"></small>
                            </div>
                        </div>

                        <div class="bio-module__editor-actions">
                            <button type="button" class="btn btn-primary" id="bio-save">Save bio</button>
                            <button type="button" class="btn btn-outline-secondary" id="bio-cancel">Cancel</button>
                            <button type="button" class="btn btn-outline-secondary" id="bio-clear">Clear</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </article>

    <article class="apply-panel experience-module">
        <div class="bio-module__toolbar">
            <p class="apply-kicker">Experience</p>
            @if (Model.CanEditProfile)
            {
                <div class="bio-module__toolbar-actions">
                    <button type="button" class="btn btn-outline-primary btn-sm" id="experience-edit-toggle">Edit</button>
                    <small id="experience-message" class="text-muted"></small>
                </div>
            }
        </div>

        <div class="experience-module__shell">
            <div id="experience-display" class="experience-module__display">
                <div id="experience-list" class="profile-list-host experience-module__list">
                    @if (Model.Profile.Experience.Count == 0)
                    {
                        <div class="experience-module__empty">
                            <p class="text-muted mb-0">No experience added yet. Add your recent roles, 3-5 highlights per role, and the skills used in each position.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in Model.Profile.Experience)
                        {
                            var experienceDates = string.Join(" - ", new[] { item.StartDate, item.IsCurrent ? "Present" : item.EndDate }.Where(x => !string.IsNullOrWhiteSpace(x)));
                            <article class="public-resume__entry experience-module__entry">
                                <div class="public-resume__entry-head">
                                    <div>
                                        @if (item.IsCurrent)
                                        {
                                            <p class="experience-module__entry-label">Current role</p>
                                        }
                                        <h3>@(item.RoleTitle ?? "Role")</h3>
                                        @if (!string.IsNullOrWhiteSpace(item.Company))
                                        {
                                            <p class="public-resume__entry-subtitle">@item.Company</p>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.Summary))
                                        {
                                            <p class="experience-module__summary">@item.Summary</p>
                                        }
                                    </div>
                                    <div class="public-resume__entry-meta">
                                        @if (!string.IsNullOrWhiteSpace(experienceDates))
                                        {
                                            <span>@experienceDates</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.Location))
                                        {
                                            <span>@item.Location</span>
                                        }
                                    </div>
                                </div>
                                @if (item.Skills?.Count > 0)
                                {
                                    <div class="public-resume__skills experience-module__skills">
                                        @foreach (var skill in item.Skills)
                                        {
                                            <span class="public-resume__skill public-resume__skill--muted">@skill</span>
                                        }
                                    </div>
                                }
                                @if (item.Highlights?.Count > 0)
                                {
                                    <ul class="experience-module__highlights">
                                        @foreach (var highlight in item.Highlights)
                                        {
                                            <li>@highlight</li>
                                        }
                                    </ul>
                                }
                            </article>
                        }
                    }
                </div>
            </div>

            @if (Model.CanEditProfile)
            {
                <div class="bio-module__editor d-none" id="experience-editor">
                    <div class="experience-module__editor-head">
                        <div>
                            <h3 class="job-subtitle mb-0">Role history</h3>
                            <p class="job-copy mb-0">List roles from most recent to least recent. Use up to 5 lines to describe the role, and up to 5 bullet highlights; Atlas will infer role skills when you leave that field blank.</p>
                        </div>
                        <button type="button" class="btn btn-outline-primary btn-sm" id="experience-add">Add role</button>
                    </div>

                    <div class="profile-section-attachment" id="experience-section-doc">
                        <div class="panel-head-row">
                            <h3 class="job-subtitle mb-0">Supporting document</h3>
                            <small class="text-muted">Optional file attached to the Experience section (e.g. portfolio samples or references).</small>
                        </div>
                        <div class="profile-inline-actions profile-inline-actions--wrap">
                            <small class="text-muted mb-0" id="section-doc-experience-name">No supporting document</small>
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                <label class="btn btn-outline-primary btn-sm mb-0" for="section-doc-experience-upload">Upload Document</label>
