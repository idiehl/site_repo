@section Scripts
{
    <script>
        (() => {
            const initialProfile = @Html.Raw(profileJson);
            const state = structuredClone(initialProfile);
            const canEdit = @Model.CanEditProfile.ToString().ToLowerInvariant();

            const messageEl = document.getElementById("profile-message");
            const warningEl = document.getElementById("profile-warning");
            const bioEditToggle = document.getElementById("bio-edit-toggle");
            const bioDisplay = document.getElementById("bio-display");
            const bioEditor = document.getElementById("bio-editor");
            const imagePreview = document.getElementById("profile-image-preview");
            const imagePlaceholder = document.getElementById("profile-image-placeholder");
            const imageOverlay = document.getElementById("profile-image-overlay");
            const profileImageTrigger = document.getElementById("profile-image-trigger");
            const imageUpload = document.getElementById("image-upload");
            const displayNamePreview = document.getElementById("profile-display-name-preview");
            const headlinePreview = document.getElementById("profile-headline-preview");
            const summaryPreview = document.getElementById("profile-summary-preview");
            const locationPreview = document.getElementById("profile-location-preview");
            const currentRoleCompanyPreview = document.getElementById("profile-role-company-preview");
            const phoneContact = document.getElementById("contact-phone");
            const emailContact = document.getElementById("contact-email");
            const linkedInContact = document.getElementById("contact-linkedin");
            const xContact = document.getElementById("contact-x");
            const instagramContact = document.getElementById("contact-instagram");
            const githubContact = document.getElementById("contact-github");
            const portfolioContact = document.getElementById("contact-portfolio");
            const resumeContact = document.getElementById("contact-resume");
            const phoneContactValue = document.getElementById("contact-phone-value");
            const emailContactValue = document.getElementById("contact-email-value");
            const linkedInContactValue = document.getElementById("contact-linkedin-value");
            const xContactValue = document.getElementById("contact-x-value");
            const instagramContactValue = document.getElementById("contact-instagram-value");
            const githubContactValue = document.getElementById("contact-github-value");
            const portfolioContactValue = document.getElementById("contact-portfolio-value");
            const resumeContactValue = document.getElementById("contact-resume-value");
            const resumeImportName = document.getElementById("resume-import-name");
            const resumeImportProcessor = document.getElementById("resume-import-processor");
            const resumeImportDate = document.getElementById("resume-import-date");
            const resumePreviewImage = document.getElementById("resume-preview-image");
            const resumePreviewPlaceholder = document.getElementById("resume-preview-placeholder");
            const resumePreviewLink = document.getElementById("resume-preview-link");
            const resumeOpenOriginal = document.getElementById("resume-open-original");
            const resumeUpload = document.getElementById("resume-upload");
            const linkedinImportResult = document.getElementById("linkedin-import-result");
            const experienceEditToggle = document.getElementById("experience-edit-toggle");
            const experienceDisplay = document.getElementById("experience-display");
            const experienceEditor = document.getElementById("experience-editor");
            const experienceMessageEl = document.getElementById("experience-message");
            const experienceEditorList = document.getElementById("experience-editor-list");
            const experienceAddButton = document.getElementById("experience-add");
            const experienceSaveButton = document.getElementById("experience-save");
            const experienceCancelButton = document.getElementById("experience-cancel");
            const experienceClearButton = document.getElementById("experience-clear");
            const bioClearButton = document.getElementById("bio-clear");
            const sectionDocBioName = document.getElementById("section-doc-bio-name");
            const sectionDocBioUpload = document.getElementById("section-doc-bio-upload");
            const sectionDocBioOpen = document.getElementById("section-doc-bio-open");
            const sectionDocExperienceName = document.getElementById("section-doc-experience-name");
            const sectionDocExperienceUpload = document.getElementById("section-doc-experience-upload");
            const sectionDocExperienceOpen = document.getElementById("section-doc-experience-open");
            let experienceDraft = [];

            const setInlineMessage = (element, message, isError = false) => {
                if (!element) return;
                element.textContent = message || "";
                element.classList.toggle("board-action-result--error", !!isError);
                element.classList.toggle("board-action-result--success", !isError && !!message);
            };

            const setMessage = (message, isError = false) => setInlineMessage(messageEl, message, isError);

            const setFieldValue = (id, value = "") => {
                const element = document.getElementById(id);
                if (element) {
                    element.value = value;
                }
            };

            const getTrimmedValue = (id) => {
                const element = document.getElementById(id);
                if (!element) return null;
                const trimmed = element.value.trim();
                return trimmed || null;
            };

            const fetchWithTimeout = async (url, options, timeoutMs = 120000) => {
                const controller = new AbortController();
                const timeoutId = window.setTimeout(() => controller.abort(), timeoutMs);
                try {
                    return await fetch(url, { ...options, signal: controller.signal });
                } finally {
                    window.clearTimeout(timeoutId);
                }
            };

            const setWarning = (items) => {
                const warnings = Array.isArray(items) ? items.filter(Boolean) : [];
                if (warnings.length === 0) {
                    warningEl.textContent = "";
                    warningEl.classList.add("d-none");
                    return;
                }

                warningEl.innerHTML = warnings.join(" ");
                warningEl.classList.remove("d-none");
            };

            const updateImageUI = () => {
                if (state.hasProfileImage && state.profileImageUrl) {
                    imagePreview.src = state.profileImageUrl;
                    imagePreview.classList.remove("d-none");
                    imagePlaceholder.classList.add("d-none");
                } else {
                    imagePreview.classList.add("d-none");
                    imagePreview.removeAttribute("src");
                    imagePlaceholder.classList.remove("d-none");
                }
            };

            const trimExperienceSummary = (value) => {
                if (!value) return null;
                const lines = value.replace(/\r\n/g, "\n").split("\n");
                const firstFive = lines.slice(0, 5).map((line) => line.replace(/\s+/g, " ").trim());
                const text = firstFive.join("\n").trim();
                return text || null;
            };

            const updateSectionDocumentUI = () => {
                if (!sectionDocBioName || !sectionDocExperienceName) return;
                const bio = state.sectionDocumentBio;
                const exp = state.sectionDocumentExperience;
                const hasBio = bio?.hasDocument && bio?.fileName;
                const hasExp = exp?.hasDocument && exp?.fileName;
                sectionDocBioName.textContent = hasBio ? bio.fileName : "No supporting document";
                sectionDocExperienceName.textContent = hasExp ? exp.fileName : "No supporting document";
                if (sectionDocBioOpen) {
                    sectionDocBioOpen.classList.toggle("d-none", !hasBio);
                    if (hasBio && bio.downloadUrl) {
                        sectionDocBioOpen.href = bio.downloadUrl;
                    } else {
                        sectionDocBioOpen.removeAttribute("href");
                    }
                }
                if (sectionDocExperienceOpen) {
                    sectionDocExperienceOpen.classList.toggle("d-none", !hasExp);
                    if (hasExp && exp.downloadUrl) {
                        sectionDocExperienceOpen.href = exp.downloadUrl;
                    } else {
                        sectionDocExperienceOpen.removeAttribute("href");
                    }
                }
            };

            const updateResumeUI = () => {
                if (!resumeImportName) return;
                resumeImportName.textContent = state.importedResumeFileName || "No resume imported yet";
                resumeImportProcessor.textContent = state.importedResumeSummary || "";
                resumeImportDate.textContent = state.importedResumeUtc
                    ? `Imported ${new Date(state.importedResumeUtc).toLocaleString()}`
                    : "";

                if (state.importedResumePreviewUrl) {
                    resumePreviewImage.src = state.importedResumePreviewUrl;
                    resumePreviewImage.classList.remove("d-none");
                    resumePreviewPlaceholder.classList.add("d-none");
                } else {
                    resumePreviewImage.classList.add("d-none");
                    resumePreviewImage.removeAttribute("src");
                    resumePreviewPlaceholder.classList.remove("d-none");
                }

                const hasResume = !!state.importedResumeDownloadUrl;
                [resumePreviewLink, resumeOpenOriginal, resumeContactValue].forEach((el) => {
                    if (!el) return;
                    if (hasResume) {
                        el.href = state.importedResumeDownloadUrl;
                        el.classList.remove("disabled");
                    } else {
                        el.removeAttribute("href");
                        el.classList.add("disabled");
                    }
                });
                resumeContact.classList.toggle("d-none", !hasResume);
            };

            const createLocalId = () => {
                const id = window.crypto?.randomUUID?.();
                return id ? id.replace(/-/g, "") : `exp${Date.now()}${Math.random().toString(16).slice(2, 8)}`;
            };

            const cloneExperienceEntry = (item = {}) => ({
                id: item.id || createLocalId(),
                roleTitle: item.roleTitle || "",
                company: item.company || "",
                location: item.location || "",
                startDate: item.startDate || "",
                endDate: item.endDate || "",
                isCurrent: !!item.isCurrent,
                summary: item.summary || "",
                highlights: Array.isArray(item.highlights) ? [...item.highlights] : [],
                skills: Array.isArray(item.skills) ? [...item.skills] : []
            });

            const normalizeLines = (value) => (value || "")
                .split(/\r?\n/)
                .map((item) => item.trim())
                .filter(Boolean);

            const normalizeSkillValues = (value) => (value || "")
                .split(/[,\n;|]/)
                .map((item) => item.trim())
                .filter(Boolean);

            const experienceMonthRank = {
                jan: 1,
                feb: 2,
                mar: 3,
                apr: 4,
                may: 5,
                jun: 6,
                jul: 7,
                aug: 8,
                sep: 9,
                sept: 9,
                oct: 10,
                nov: 11,
                dec: 12
            };

            const getExperienceDateRank = (value) => {
                if (!value) return 0;
                const lowered = value.toLowerCase();
                if (lowered.includes("present") || lowered.includes("current")) {
                    return Number.MAX_SAFE_INTEGER;
                }

                const yearMatch = lowered.match(/\b(19|20)\d{2}\b/);
                if (!yearMatch) {
                    return 0;
                }

                const monthMatch = lowered.match(/\b(jan|feb|mar|apr|may|jun|jul|aug|sep|sept|oct|nov|dec)[a-z]*\b/);
                const year = Number(yearMatch[0]);
                const month = monthMatch ? (experienceMonthRank[monthMatch[1]] || 12) : 12;
                return (year * 12) + month;
            };

            const getExperienceSortRank = (item) => {
                if (item?.isCurrent) {
                    return Number.MAX_SAFE_INTEGER;
                }

                return Math.max(
                    getExperienceDateRank(item?.endDate),
                    getExperienceDateRank(item?.startDate)
                );
            };

            const sortExperienceEntries = (items) => [...(items || [])]
                .map((item, index) => ({ item, index }))
                .sort((left, right) => {
                    const currentDiff = Number(right.item?.isCurrent) - Number(left.item?.isCurrent);
                    if (currentDiff !== 0) {
                        return currentDiff;
                    }

                    const rankDiff = getExperienceSortRank(right.item) - getExperienceSortRank(left.item);
                    if (rankDiff !== 0) {
                        return rankDiff;
                    }

                    return left.index - right.index;
                })
                .map(({ item }) => item);

            const buildStatePayload = () => ({
                email: state.email || null,
                displayName: state.displayName || null,
                headline: state.headline || null,
                summary: state.summary || null,
                location: state.location || null,
                phoneNumber: state.phoneNumber || null,
                linkedInUrl: state.linkedInUrl || null,
                xUrl: state.xUrl || null,
                instagramUrl: state.instagramUrl || null,
                githubUrl: state.githubUrl || null,
                portfolioUrl: state.portfolioUrl || null,
                currentRoleTitle: state.preferences?.currentRoleTitle ?? null,
                currentCompany: state.preferences?.currentCompany ?? null,
                skills: Array.isArray(state.skills) ? [...state.skills] : [],
                experience: structuredClone(state.experience || []),
                education: structuredClone(state.education || []),
                projects: structuredClone(state.projects || []),
                certifications: structuredClone(state.certifications || []),
                preferences: {
                    currentRoleTitle: state.preferences?.currentRoleTitle ?? null,
                    currentCompany: state.preferences?.currentCompany ?? null,
                    targetRoles: state.preferences?.targetRoles || null,
                    targetIndustries: state.preferences?.targetIndustries || null,
                    workModes: state.preferences?.workModes || null,
                    preferredLocations: state.preferences?.preferredLocations || null,
                    xUrl: state.preferences?.xUrl ?? state.xUrl ?? null,
                    instagramUrl: state.preferences?.instagramUrl ?? state.instagramUrl ?? null,
                    notes: state.preferences?.notes || null
                }
            });

            const buildPayload = (overrides = {}) => {
                const payload = buildStatePayload();
                return {
                    ...payload,
                    ...overrides,
                    preferences: {
                        ...payload.preferences,
                        ...(overrides.preferences || {})
                    }
                };
            };

            const buildBioPayload = () => {
                const currentRoleTitle = getTrimmedValue("current-role-title");
                const currentCompany = getTrimmedValue("current-company");
                const xUrl = getTrimmedValue("x-url");
                const instagramUrl = getTrimmedValue("instagram-url");

                return buildPayload({
                    email: getTrimmedValue("email"),
                    displayName: getTrimmedValue("display-name"),
                    headline: getTrimmedValue("headline"),
                    summary: getTrimmedValue("summary"),
                    location: getTrimmedValue("location"),
                    phoneNumber: getTrimmedValue("phone-number"),
                    linkedInUrl: getTrimmedValue("linkedin-url"),
                    xUrl,
                    instagramUrl,
                    githubUrl: getTrimmedValue("github-url"),
                    portfolioUrl: getTrimmedValue("portfolio-url"),
                    currentRoleTitle,
                    currentCompany,
                    preferences: {
                        currentRoleTitle,
                        currentCompany,
                        targetRoles: getTrimmedValue("target-roles"),
                        targetIndustries: getTrimmedValue("target-industries"),
                        workModes: getTrimmedValue("work-modes"),
                        preferredLocations: getTrimmedValue("preferred-locations"),
                        xUrl,
                        instagramUrl,
                        notes: getTrimmedValue("preference-notes")
                    }
                });
            };

            const sanitizeExperience = (items) => items
                .map((item) => {
                    const highlightsRaw = Array.isArray(item.highlights)
                        ? item.highlights.map((highlight) => highlight.trim()).filter(Boolean)
                        : [];
                    const highlights = highlightsRaw
                        .filter((h, i, arr) => arr.findIndex((x) => x.toLowerCase() === h.toLowerCase()) === i)
                        .slice(0, 5);
                    const skills = Array.isArray(item.skills)
                        ? item.skills.map((skill) => skill.trim()).filter(Boolean)
                        : [];

                    const normalized = {
                        id: item.id || createLocalId(),
                        roleTitle: item.roleTitle?.trim() || null,
                        company: item.company?.trim() || null,
                        location: item.location?.trim() || null,
                        startDate: item.startDate?.trim() || null,
                        endDate: item.isCurrent ? null : (item.endDate?.trim() || null),
                        isCurrent: !!item.isCurrent,
                        summary: trimExperienceSummary(item.summary),
                        highlights,
                        skills
                    };

                    const hasContent = normalized.roleTitle
                        || normalized.company
                        || normalized.location
                        || normalized.startDate
                        || normalized.endDate
                        || normalized.summary
                        || normalized.highlights.length
                        || normalized.skills.length;

                    return hasContent ? normalized : null;
                })
                .filter(Boolean);

            const fillBasics = () => {
                if (!canEdit) return;
                setFieldValue("display-name", state.displayName || "");
                setFieldValue("headline", state.headline || "");
                setFieldValue("summary", state.summary || "");
                setFieldValue("location", state.location || "");
                setFieldValue("phone-number", state.phoneNumber || "");
                setFieldValue("email", state.email || "");
                setFieldValue("linkedin-url", state.linkedInUrl || "");
                setFieldValue("x-url", state.xUrl || "");
                setFieldValue("instagram-url", state.instagramUrl || "");
                setFieldValue("github-url", state.githubUrl || "");
                setFieldValue("portfolio-url", state.portfolioUrl || "");
                setFieldValue("current-role-title", state.currentRoleTitle || "");
                setFieldValue("current-company", state.currentCompany || "");
                setFieldValue("target-roles", state.preferences?.targetRoles || "");
                setFieldValue("target-industries", state.preferences?.targetIndustries || "");
                setFieldValue("work-modes", state.preferences?.workModes || "");
                setFieldValue("preferred-locations", state.preferences?.preferredLocations || "");
                setFieldValue("preference-notes", state.preferences?.notes || "");
                setFieldValue("linkedin-import-url", state.linkedInUrl || "");
            };

            const updateBioPreview = () => {
                const displayName = canEdit ? (document.getElementById("display-name").value.trim() || "Your Name") : (state.displayName || "Your Name");
                const headline = canEdit ? (document.getElementById("headline").value.trim() || "Add a clear headline for the roles you want.") : (state.headline || "Add a clear headline for the roles you want.");
                const summary = canEdit ? (document.getElementById("summary").value.trim() || "Use this page as the polished source of truth for your experience, skills, and application materials.") : (state.summary || "Use this page as the polished source of truth for your experience, skills, and application materials.");
                const location = canEdit ? document.getElementById("location").value.trim() : (state.location || "");
                const phone = canEdit ? document.getElementById("phone-number").value.trim() : (state.phoneNumber || "");
                const email = canEdit ? document.getElementById("email").value.trim() : (state.email || "");
                const linkedIn = canEdit ? document.getElementById("linkedin-url").value.trim() : (state.linkedInUrl || "");
                const xUrl = canEdit ? document.getElementById("x-url").value.trim() : (state.xUrl || "");
                const instagram = canEdit ? document.getElementById("instagram-url").value.trim() : (state.instagramUrl || "");
                const github = canEdit ? document.getElementById("github-url").value.trim() : (state.githubUrl || "");
                const portfolio = canEdit ? document.getElementById("portfolio-url").value.trim() : (state.portfolioUrl || "");
                const currentRoleTitle = canEdit ? document.getElementById("current-role-title").value.trim() : (state.currentRoleTitle || "");
                const currentCompany = canEdit ? document.getElementById("current-company").value.trim() : (state.currentCompany || "");
                const currentRoleCompany = [currentRoleTitle, currentCompany].filter(Boolean).join(" at ");

                displayNamePreview.textContent = displayName;
                headlinePreview.textContent = headline;
                summaryPreview.textContent = summary;

                locationPreview.textContent = location;
                locationPreview.classList.toggle("d-none", !location);

                currentRoleCompanyPreview.textContent = currentRoleCompany;
                currentRoleCompanyPreview.classList.toggle("d-none", !currentRoleCompany);

                phoneContactValue.textContent = phone;
                phoneContact.classList.toggle("d-none", !phone);

                emailContactValue.textContent = email;
                emailContactValue.href = email ? `mailto:${email}` : "#";
                emailContact.classList.toggle("d-none", !email);

                linkedInContactValue.href = linkedIn || "#";
                linkedInContactValue.textContent = linkedIn;
                linkedInContact.classList.toggle("d-none", !linkedIn);

                xContactValue.href = xUrl || "#";
                xContactValue.textContent = xUrl;
                xContact.classList.toggle("d-none", !xUrl);

                instagramContactValue.href = instagram || "#";
                instagramContactValue.textContent = instagram;
                instagramContact.classList.toggle("d-none", !instagram);

                githubContactValue.href = github || "#";
                githubContactValue.textContent = github;
                githubContact.classList.toggle("d-none", !github);

                portfolioContactValue.href = portfolio || "#";
                portfolioContactValue.textContent = portfolio;
                portfolioContact.classList.toggle("d-none", !portfolio);
            };

            const createSkillChip = (skill) => {
                const fragment = document.getElementById("skill-template").content.cloneNode(true);
                fragment.querySelector(".public-resume__skill").textContent = skill;
                return fragment;
            };

            const renderSkills = () => {
                const host = document.getElementById("skills-list");
                host.innerHTML = "";
                const skills = state.skills || [];
                if (skills.length === 0) {
                    host.innerHTML = '<p class="text-muted mb-0">No skills added yet.</p>';
                    return;
                }

                skills.forEach((skill) => host.appendChild(createSkillChip(skill)));
            };

            const renderExperience = () => {
                const host = document.getElementById("experience-list");
                if (!host) return;
                host.innerHTML = "";
                const items = sortExperienceEntries(state.experience || []);
                if (items.length === 0) {
                    host.innerHTML = '<div class="experience-module__empty"><p class="text-muted mb-0">No experience added yet. Add your recent roles, 3-5 highlights per role, and the skills used in each position.</p></div>';
                    return;
                }

                items.forEach((item) => {
                    const fragment = document.getElementById("experience-display-template").content.cloneNode(true);
                    const status = fragment.querySelector("[data-status]");
                    status.textContent = item.isCurrent ? "Current role" : "";
                    status.classList.toggle("d-none", !item.isCurrent);
                    fragment.querySelector("[data-role-title]").textContent = item.roleTitle || "Role";
                    const company = fragment.querySelector("[data-company]");
                    company.textContent = item.company || "";
                    company.classList.toggle("d-none", !item.company);
                    const dates = fragment.querySelector("[data-dates]");
                    dates.textContent = [item.startDate, item.isCurrent ? "Present" : item.endDate].filter(Boolean).join(" - ");
                    dates.classList.toggle("d-none", !dates.textContent);
                    const location = fragment.querySelector("[data-location]");
                    location.textContent = item.location || "";
                    location.classList.toggle("d-none", !item.location);

                    const summary = fragment.querySelector("[data-summary]");
                    if (summary) {
                        summary.textContent = item.summary || "";
                        summary.classList.toggle("d-none", !item.summary);
                    }

                    const skills = fragment.querySelector("[data-skills]");
                    skills.innerHTML = "";
                    (item.skills || []).forEach((skill) => {
                        const span = document.createElement("span");
                        span.className = "public-resume__skill public-resume__skill--muted";
                        span.textContent = skill;
                        skills.appendChild(span);
                    });
                    skills.classList.toggle("d-none", !skills.children.length);

                    const ul = fragment.querySelector("[data-highlights]");
                    ul.innerHTML = "";
                    (item.highlights || []).forEach((highlight) => {
                        const li = document.createElement("li");
                        li.textContent = highlight;
                        ul.appendChild(li);
                    });
                    ul.classList.toggle("d-none", !ul.children.length);

                    host.appendChild(fragment);
                });
            };

            const getExperienceEntryTitle = (item, index) => {
                const roleTitle = item.roleTitle?.trim();
                const company = item.company?.trim();
                if (roleTitle && company) {
                    return `${roleTitle} at ${company}`;
                }

                return roleTitle || company || `Role ${index + 1}`;
            };

            const updateExperienceEndDateState = (input, item) => {
                if (!input) return;
                input.disabled = !!item.isCurrent;
                input.placeholder = item.isCurrent ? "Present" : "Dec 2025";
                if (item.isCurrent) {
                    input.value = "";
                }
            };

            const renderExperienceEditor = () => {
                if (!canEdit || !experienceEditorList) return;
                experienceEditorList.innerHTML = "";

                if (experienceDraft.length === 0) {
                    experienceEditorList.innerHTML = '<div class="experience-module__empty experience-module__empty--editor"><p class="text-muted mb-0">No roles added yet. Start with your current or most relevant role.</p></div>';
                    return;
                }

                experienceDraft.forEach((item, index) => {
                    const fragment = document.getElementById("experience-editor-template").content.cloneNode(true);
                    const card = fragment.querySelector(".profile-entry");
                    const title = card.querySelector("[data-entry-title]");
                    const roleTitleInput = card.querySelector('[data-field="roleTitle"]');
                    const companyInput = card.querySelector('[data-field="company"]');
                    const locationInput = card.querySelector('[data-field="location"]');
                    const startDateInput = card.querySelector('[data-field="startDate"]');
                    const endDateInput = card.querySelector('[data-end-date]');
                    const currentRoleInput = card.querySelector('[data-field="isCurrent"]');
                    const summaryInput = card.querySelector('[data-field="summary"]');
                    const highlightsInput = card.querySelector('[data-field="highlights"]');
                    const skillsInput = card.querySelector('[data-field="skills"]');
                    const removeButton = card.querySelector("[data-remove]");

                    title.textContent = getExperienceEntryTitle(item, index);
                    roleTitleInput.value = item.roleTitle || "";
                    companyInput.value = item.company || "";
                    locationInput.value = item.location || "";
                    startDateInput.value = item.startDate || "";
                    endDateInput.value = item.endDate || "";
                    currentRoleInput.checked = !!item.isCurrent;
                    summaryInput.value = item.summary || "";
                    highlightsInput.value = (item.highlights || []).join("\n");
                    skillsInput.value = (item.skills || []).join(", ");
                    updateExperienceEndDateState(endDateInput, item);

                    roleTitleInput.addEventListener("input", (event) => {
                        experienceDraft[index].roleTitle = event.target.value;
                        title.textContent = getExperienceEntryTitle(experienceDraft[index], index);
                    });

                    companyInput.addEventListener("input", (event) => {
                        experienceDraft[index].company = event.target.value;
                        title.textContent = getExperienceEntryTitle(experienceDraft[index], index);
                    });

                    locationInput.addEventListener("input", (event) => {
                        experienceDraft[index].location = event.target.value;
                    });

                    startDateInput.addEventListener("input", (event) => {
                        experienceDraft[index].startDate = event.target.value;
                    });

                    endDateInput.addEventListener("input", (event) => {
                        experienceDraft[index].endDate = event.target.value;
                    });

                    currentRoleInput.addEventListener("change", (event) => {
                        const checked = event.target.checked;
                        experienceDraft = sortExperienceEntries(experienceDraft.map((entry, entryIndex) => {
                            if (entryIndex === index) {
                                return {
                                    ...entry,
                                    isCurrent: checked,
                                    endDate: checked ? "" : entry.endDate
                                };
                            }

                            return checked ? { ...entry, isCurrent: false } : entry;
                        }));

                        renderExperienceEditor();
                    });

                    summaryInput.addEventListener("input", (event) => {
                        const raw = event.target.value.replace(/\r\n/g, "\n");
                        const parts = raw.split("\n");
                        if (parts.length > 5) {
                            event.target.value = parts.slice(0, 5).join("\n");
                        }
                        experienceDraft[index].summary = event.target.value;
                    });

                    highlightsInput.addEventListener("input", (event) => {
                        let lines = normalizeLines(event.target.value);
                        if (lines.length > 5) {
                            lines = lines.slice(0, 5);
                            event.target.value = lines.join("\n");
                        }
                        experienceDraft[index].highlights = lines;
                    });

                    skillsInput.addEventListener("input", (event) => {
                        experienceDraft[index].skills = normalizeSkillValues(event.target.value);
                    });

                    removeButton.addEventListener("click", () => {
                        experienceDraft = experienceDraft.filter((_, entryIndex) => entryIndex !== index);
                        renderExperienceEditor();
                    });

                    experienceEditorList.appendChild(fragment);
                });
            };

            const resetExperienceDraft = () => {
                experienceDraft = sortExperienceEntries((state.experience || []).map(cloneExperienceEntry));
                renderExperienceEditor();
            };

            const renderEducation = () => {
                const host = document.getElementById("education-list");
                host.innerHTML = "";
                const items = state.education || [];
                if (items.length === 0) {
                    host.innerHTML = '<p class="text-muted mb-0">No education added yet.</p>';
                    return;
                }

                items.forEach((item) => {
                    const fragment = document.getElementById("education-display-template").content.cloneNode(true);
                    fragment.querySelector("[data-school]").textContent = item.school || "Education";
                    fragment.querySelector("[data-degree]").textContent = [item.degree, item.fieldOfStudy].filter(Boolean).join(", ");
                    fragment.querySelector("[data-dates]").textContent = [item.startDate, item.endDate].filter(Boolean).join(" - ");
                    fragment.querySelector("[data-location]").textContent = item.location || "";

                    const summary = fragment.querySelector("[data-summary]");
                    summary.textContent = item.summary || "";
                    summary.classList.toggle("d-none", !item.summary);

                    host.appendChild(fragment);
                });
            };

            const renderProjects = () => {
                const host = document.getElementById("projects-list");
                host.innerHTML = "";
                const items = state.projects || [];
                if (items.length === 0) {
                    host.innerHTML = '<p class="text-muted mb-0">No projects added yet.</p>';
                    return;
                }

                items.forEach((item) => {
                    const fragment = document.getElementById("project-display-template").content.cloneNode(true);
                    fragment.querySelector("[data-name]").textContent = item.name || "Project";
                    fragment.querySelector("[data-role]").textContent = item.role || "";
                    fragment.querySelector("[data-dates]").textContent = [item.startDate, item.endDate].filter(Boolean).join(" - ");

                    const summary = fragment.querySelector("[data-summary]");
                    summary.textContent = item.summary || "";
                    summary.classList.toggle("d-none", !item.summary);

                    const link = fragment.querySelector("[data-link]");
                    if (item.url) {
                        link.href = item.url;
                    } else {
                        link.classList.add("d-none");
                    }

                    const techWrap = fragment.querySelector("[data-technologies]");
                    techWrap.innerHTML = "";
                    (item.technologies || []).forEach((tech) => {
                        const span = document.createElement("span");
                        span.className = "public-resume__skill public-resume__skill--muted";
                        span.textContent = tech;
                        techWrap.appendChild(span);
                    });
                    techWrap.classList.toggle("d-none", !techWrap.children.length);

                    const ul = fragment.querySelector("[data-highlights]");
                    ul.innerHTML = "";
                    (item.highlights || []).forEach((highlight) => {
                        const li = document.createElement("li");
                        li.textContent = highlight;
                        ul.appendChild(li);
                    });
                    ul.classList.toggle("d-none", !ul.children.length);

                    host.appendChild(fragment);
                });
            };

            const renderCertifications = () => {
                const host = document.getElementById("certifications-list");
                host.innerHTML = "";
                const items = state.certifications || [];
                if (items.length === 0) {
                    host.innerHTML = '<p class="text-muted mb-0">No certifications added yet.</p>';
                    return;
                }

                items.forEach((item) => {
                    const fragment = document.getElementById("certification-display-template").content.cloneNode(true);
                    fragment.querySelector("[data-name]").textContent = item.name || "Certification";
                    fragment.querySelector("[data-issuer]").textContent = item.issuer || "";
                    fragment.querySelector("[data-issued]").textContent = item.issueDate ? `Issued ${item.issueDate}` : "";

                    const summary = fragment.querySelector("[data-summary]");
                    summary.textContent = item.summary || "";
                    summary.classList.toggle("d-none", !item.summary);

                    const link = fragment.querySelector("[data-link]");
                    if (item.credentialUrl) {
                        link.href = item.credentialUrl;
                    } else {
                        link.classList.add("d-none");
                    }

                    host.appendChild(fragment);
                });
            };

            const applyProfileState = (profile) => {
                Object.assign(state, profile);
                state.experience = sortExperienceEntries(Array.isArray(state.experience) ? state.experience : []);
                fillBasics();
                updateImageUI();
                updateResumeUI();
                updateSectionDocumentUI();
                updateBioPreview();
                renderSkills();
                renderExperience();
                renderEducation();
                renderProjects();
                renderCertifications();
                if (canEdit) {
                    resetExperienceDraft();
                }
            };

            const setBioEditing = (editing) => {
                if (!canEdit || !bioEditor || !bioDisplay || !bioEditToggle) return;
                bioEditor.classList.toggle("d-none", !editing);
                bioDisplay.classList.toggle("d-none", editing);
                bioEditToggle.textContent = editing ? "Close" : "Edit";
                if (imageOverlay) {
                    imageOverlay.classList.toggle("d-none", !editing);
                }
            };

            const setExperienceEditing = (editing) => {
                if (!canEdit || !experienceEditor || !experienceDisplay || !experienceEditToggle) return;
                experienceEditor.classList.toggle("d-none", !editing);
                experienceDisplay.classList.toggle("d-none", editing);
                experienceEditToggle.textContent = editing ? "Close" : "Edit";
            };

            if (canEdit && bioEditToggle) {
                bioEditToggle.addEventListener("click", () => {
                    const editing = bioEditor.classList.contains("d-none");
                    if (editing) {
                        setExperienceEditing(false);
                    }
                    setBioEditing(editing);
                });

                ["display-name", "headline", "summary", "location", "phone-number", "email", "linkedin-url", "x-url", "instagram-url", "github-url", "portfolio-url", "current-role-title", "current-company"]
                    .forEach((id) => document.getElementById(id).addEventListener("input", updateBioPreview));

                profileImageTrigger.addEventListener("click", () => {
                    if (!bioEditor.classList.contains("d-none")) {
                        imageUpload.click();
                    }
                });

                document.getElementById("bio-save").addEventListener("click", async () => {
                    setMessage("Saving...");
                    setWarning([]);
                    try {
                        const response = await fetchWithTimeout("/api/v2/profile", {
                            method: "PUT",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify(buildBioPayload())
                        }, 60000);

                        if (!response.ok) {
                            const data = await response.json().catch(() => ({}));
                            setMessage(data.error || "Unable to save profile.", true);
                            return;
                        }

                        const profile = await response.json();
                        applyProfileState(profile);
                        setBioEditing(false);
                        setMessage("Bio updated.");
                    } catch (error) {
                        const message = error?.name === "AbortError"
                            ? "Saving took too long. Please try again."
                            : "Unable to save profile right now.";
                        setMessage(message, true);
                    }
                });

                document.getElementById("bio-cancel").addEventListener("click", () => {
                    fillBasics();
                    updateBioPreview();
                    setBioEditing(false);
                    setMessage("");
                });

                const patchSectionDocumentsFromProfile = (profile) => {
                    if (!profile) {
                        return;
                    }
                    state.sectionDocumentBio = profile.sectionDocumentBio;
                    state.sectionDocumentExperience = profile.sectionDocumentExperience;
                    updateSectionDocumentUI();
                };

                const clearBioEditorFields = () => {
                    [
                        "display-name", "headline", "summary", "location", "phone-number", "email", "linkedin-url", "x-url", "instagram-url", "github-url", "portfolio-url", "current-role-title", "current-company", "linkedin-import-url", "linkedin-import-text"
                    ].forEach((id) => setFieldValue(id, ""));
                    state.displayName = "";
                    state.headline = "";
                    state.summary = "";
                    state.location = "";
                    state.phoneNumber = "";
                    state.email = "";
                    state.linkedInUrl = "";
                    state.xUrl = "";
                    state.instagramUrl = "";
                    state.githubUrl = "";
                    state.portfolioUrl = "";
                    state.currentRoleTitle = "";
                    state.currentCompany = "";
                    state.preferences = state.preferences || {};
                    state.preferences.currentRoleTitle = "";
                    state.preferences.currentCompany = "";
                    state.preferences.xUrl = "";
                    state.preferences.instagramUrl = "";
                    updateBioPreview();
                };

                bioClearButton?.addEventListener("click", async () => {
                    clearBioEditorFields();
                    setMessage("");
                    try {
                        const response = await fetchWithTimeout("/api/v2/profile/section-documents/bio", { method: "DELETE" }, 60000);
                        if (response.ok) {
                            const profile = await response.json();
                            patchSectionDocumentsFromProfile(profile);
                        }
                    } catch {
                        // Section document delete is optional if none existed
                    }
                });

                if (experienceEditToggle) {
                    experienceEditToggle.addEventListener("click", () => {
                        const editing = experienceEditor.classList.contains("d-none");
                        if (editing) {
                            setBioEditing(false);
                        }
                        setExperienceEditing(editing);
                    });
                }

                experienceAddButton?.addEventListener("click", () => {
                    experienceDraft = [cloneExperienceEntry(), ...experienceDraft];
                    renderExperienceEditor();
                    experienceEditorList?.querySelector('[data-field="roleTitle"]')?.focus();
                });

                experienceSaveButton?.addEventListener("click", async () => {
                    setInlineMessage(experienceMessageEl, "Saving...");
                    setWarning([]);
                    try {
                        const response = await fetchWithTimeout("/api/v2/profile", {
                            method: "PUT",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify(buildPayload({
                                experience: sanitizeExperience(sortExperienceEntries(experienceDraft))
                            }))
                        }, 60000);

                        if (!response.ok) {
                            const data = await response.json().catch(() => ({}));
                            setInlineMessage(experienceMessageEl, data.error || "Unable to save experience.", true);
                            return;
                        }

                        const profile = await response.json();
                        applyProfileState(profile);
                        setExperienceEditing(false);
                        setInlineMessage(experienceMessageEl, "Experience updated.");
                    } catch (error) {
                        const message = error?.name === "AbortError"
                            ? "Saving took too long. Please try again."
                            : "Unable to save experience right now.";
                        setInlineMessage(experienceMessageEl, message, true);
                    }
                });

                experienceCancelButton?.addEventListener("click", () => {
                    resetExperienceDraft();
                    setExperienceEditing(false);
                    setInlineMessage(experienceMessageEl, "");
                });

                experienceClearButton?.addEventListener("click", async () => {
                    experienceDraft = [];
                    renderExperienceEditor();
                    setInlineMessage(experienceMessageEl, "");
                    try {
                        const response = await fetchWithTimeout("/api/v2/profile/section-documents/experience", { method: "DELETE" }, 60000);
                        if (response.ok) {
                            const profile = await response.json();
                            patchSectionDocumentsFromProfile(profile);
                        }
                    } catch {
                        // Optional cleanup when no file existed
                    }
                });

                const postSectionDocument = async (section, file) => {
                    const body = new FormData();
                    body.append("file", file);
                    const response = await fetchWithTimeout(`/api/v2/profile/section-documents/${section}`, { method: "POST", body }, 120000);
                    if (!response.ok) {
                        const data = await response.json().catch(() => ({}));
                        throw new Error(data.error || "Document upload failed.");
                    }
                    return response.json();
                };

                sectionDocBioUpload?.addEventListener("change", async (event) => {
                    const file = event.target.files?.[0];
                    event.target.value = "";
                    if (!file) {
                        return;
                    }
                    if (file.size > 5 * 1024 * 1024) {
                        setMessage("Document must be 5 MB or smaller.", true);
                        return;
                    }
                    setMessage("Uploading...");
                    setWarning([]);
                    try {
                        const data = await postSectionDocument("bio", file);
                        if (data?.profile) {
                            patchSectionDocumentsFromProfile(data.profile);
                        }
                        setWarning(data.warnings || []);
                        setMessage(data.warnings?.length ? "Supporting document uploaded (see note above)." : "Supporting document uploaded.");
                    } catch (error) {
                        setMessage(error?.message || "Upload failed.", true);
                    }
                });

                sectionDocExperienceUpload?.addEventListener("change", async (event) => {
                    const file = event.target.files?.[0];
                    event.target.value = "";
                    if (!file) {
                        return;
                    }
                    if (file.size > 5 * 1024 * 1024) {
                        setInlineMessage(experienceMessageEl, "Document must be 5 MB or smaller.", true);
                        return;
                    }
                    setInlineMessage(experienceMessageEl, "Uploading...");
                    setWarning([]);
                    try {
                        const data = await postSectionDocument("experience", file);
                        if (data?.profile) {
                            patchSectionDocumentsFromProfile(data.profile);
                        }
                        setWarning(data.warnings || []);
                        setInlineMessage(experienceMessageEl, data.warnings?.length ? "Uploaded (see global notice)." : "Supporting document uploaded.");
                    } catch (error) {
                        setInlineMessage(experienceMessageEl, error?.message || "Upload failed.", true);
                    }
                });

                resumeUpload.addEventListener("change", async (event) => {
                    const file = event.target.files?.[0];
                    if (!file) return;

                    if (file.size > 5 * 1024 * 1024) {
                        setMessage("Resume files must be 5 MB or smaller.", true);
                        event.target.value = "";
                        return;
                    }

                    setMessage("Importing resume...");
                    setWarning([]);
                    const body = new FormData();
                    body.append("file", file);
                    try {
                        const response = await fetchWithTimeout("/api/v2/profile/import-resume", {
                            method: "POST",
                            body
                        }, 180000);

                        event.target.value = "";

                        if (!response.ok) {
                            const data = await response.json().catch(() => ({}));
                            setMessage(data.error || "Resume import failed.", true);
                            return;
                        }

                        const data = await response.json();
                        applyProfileState(data.profile);
                        setWarning(data.warnings || []);
                        setMessage("Resume imported. Review the bio details and save any changes.");
                    } catch (error) {
                        event.target.value = "";
                        const message = error?.name === "AbortError"
                            ? "Resume import took too long. Try a smaller PDF or DOCX file."
                            : "Resume import failed before the server returned a response.";
                        setMessage(message, true);
                    }
                });

                document.getElementById("import-linkedin").addEventListener("click", async () => {
                    setInlineMessage(linkedinImportResult, "Importing...");
                    setWarning([]);
                    try {
                        const response = await fetchWithTimeout("/api/v2/profile/import-linkedin", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                linkedInUrl: document.getElementById("linkedin-import-url").value || null,
                                profileText: document.getElementById("linkedin-import-text").value || null
                            })
                        }, 120000);

                        if (!response.ok) {
                            const data = await response.json().catch(() => ({}));
                            setInlineMessage(linkedinImportResult, data.error || "LinkedIn import failed.", true);
                            return;
                        }

                        const data = await response.json();
                        applyProfileState(data.profile);
                        setWarning(data.warnings || []);
                        document.getElementById("linkedin-import-text").value = "";
                        setInlineMessage(linkedinImportResult, "LinkedIn profile imported.");
                    } catch (error) {
                        const message = error?.name === "AbortError"
                            ? "LinkedIn import took too long. Try pasting the visible profile text instead."
                            : "LinkedIn import failed before the server returned a response.";
                        setInlineMessage(linkedinImportResult, message, true);
                    }
                });

                imageUpload.addEventListener("change", async (event) => {
                    const file = event.target.files?.[0];
                    if (!file) return;

                    setMessage("Uploading image...");
                    const body = new FormData();
                    body.append("file", file);
                    try {
                        const response = await fetchWithTimeout("/api/v2/profile/image", {
                            method: "POST",
                            body
                        }, 120000);

                        event.target.value = "";

                        if (!response.ok) {
                            const data = await response.json().catch(() => ({}));
                            setMessage(data.error || "Image upload failed.", true);
                            return;
                        }

                        const profile = await response.json();
                        applyProfileState(profile);
                        setMessage("Profile image updated.");
                    } catch (error) {
                        event.target.value = "";
                        const message = error?.name === "AbortError"
                            ? "Image upload took too long. Please try again."
                            : "Image upload failed before the server returned a response.";
                        setMessage(message, true);
                    }
                });

            } else {
                profileImageTrigger.setAttribute("disabled", "disabled");
            }

            applyProfileState(state);
            setBioEditing(false);
            setExperienceEditing(false);
        })();
    </script>
}
