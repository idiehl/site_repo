}

<section class="section">
    <div class="section-header">
        <span class="section-number">Explore</span>
        <h1 class="section-title">Atlas Explorer Preview</h1>
        <p class="section-lede">
            Explorer is scheduled after landing and identity foundations. This placeholder confirms CTA routing and page structure.
        </p>
