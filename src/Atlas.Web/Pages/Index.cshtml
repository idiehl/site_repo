@page
@model IndexModel
@{
    ViewData["Title"] = "Atlas Universalis";
}

<section class="landing-hero" id="hero" aria-label="Atlas Universalis hero">
    <div class="landing-hero-bg" aria-hidden="true">
        <div class="landing-hero-stars stars-layer-a"></div>
        <div class="landing-hero-stars stars-layer-b"></div>
        <div class="landing-hero-stars stars-layer-c"></div>
        <div class="landing-hero-map-lines"></div>
        <div class="landing-hero-vline"></div>
        <div class="landing-hero-glow"></div>
        <div class="landing-hero-atlas-wrap">
            <img src="~/img/au-icon-atlas-globe-2048.png" class="landing-hero-atlas" alt="" />
        </div>
    </div>

    <div class="landing-hero-content">
        <h1 class="landing-hero-wordmark">
            <span>Atlas</span>
            <span>Universalis</span>
        </h1>
        <div class="landing-hero-divider" aria-hidden="true">
            <span></span>
            <span class="star-glyph">✦</span>
            <span></span>
        </div>
        <p class="landing-hero-kicker">Custom Software Strategy & Delivery</p>
        <p class="landing-hero-subtitle">We build custom solutions around the unique challenges our clients face - no templates, no pre-packaged products, no least-common-denominator compromises.</p>
    </div>

    <div class="landing-hero-scroll" aria-hidden="true">
        <span>Explore</span>
    </div>
</section>

<section class="landing-principles" id="principles" aria-label="Core principles">
    <div class="landing-container">
        <div class="principles-intro">
            <p class="principles-kicker">Core Values</p>
            <h2 class="principles-title">Many challenges. One solution mindset.</h2>
            <p class="principles-lede">Our process is rooted in research, insight, analysis, and close observation of the problem itself - then building the right solution for that exact context.</p>
        </div>
        <div class="principles-grid">
            <article class="principle-card">
                <h3>Challenge reveals exceptionalism</h3>
                <p>We treat hard problems as opportunities to demonstrate uncommon precision, judgment, and craft.</p>
            </article>
            <article class="principle-card">
                <h3>Custom over commodity</h3>
                <p>No one-size-fits-all model. Every system is shaped by your constraints, objectives, and environment.</p>
            </article>
            <article class="principle-card">
                <h3>Solutions built on evidence</h3>
                <p>Our work is guided by research and observation first, then translated into clear, practical implementation.</p>
            </article>
        </div>
    </div>
</section>
