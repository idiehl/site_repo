<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Atlas Universalis</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Playfair+Display:wght@400;700&display=swap" />
    <link rel="stylesheet" href="~/css/atlas.tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Atlas.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container">
            <a class="brand" asp-area="" asp-page="/Index">Atlas Universalis</a>
            <nav class="header-nav" aria-label="Primary">
                <a class="nav-link" asp-area="" asp-page="/Account/Create">Create Account</a>
                <a class="nav-link" asp-area="" asp-page="/Explore">Explore</a>
                <a class="health-link" href="/healthz">Health</a>
            </nav>
        </div>
    </header>

    <div class="container">
        <main role="main" class="main">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container">
            &copy; @DateTime.UtcNow.Year Atlas Universalis
        </div>
    </footer>

    <script src="_framework/blazor.server.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
